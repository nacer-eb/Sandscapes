def create_mpl_plot(id, ax, update_vedo, gate_masks, GATE, master_mask):

    #GATE = 1
    ids = np.asarray([
        [ordered_genes.index("Itgam"), ordered_genes.index("Cd3g")],
        [ordered_genes.index("Fcer1a"), ordered_genes.index("Gypa")],
        [ordered_genes.index("Itga2b"), ordered_genes.index("Ptprc")],
        [ordered_genes.index("Ly6a"), ordered_genes.index("Kit")]
    ])
    
    # Second gate
    if GATE>1:
        ids = np.asarray([
            [ordered_genes.index("Ly6a"), ordered_genes.index("Kit")],
            [ordered_genes.index("Slamf1"), ordered_genes.index("Fcgr3")],
            [ordered_genes.index("Cd34"), ordered_genes.index("Slamf1")],
            [ordered_genes.index("Cd34"), ordered_genes.index("Fcgr3")]
        ])
    
    x_expr = data_matrix_markers[:, ids[id, 0]]
    y_expr = data_matrix_markers[:, ids[id, 1]]
    x_name = annotated_genes[marker_plotting_order][ids[id, 0]]
    y_name = annotated_genes[marker_plotting_order][ids[id, 1]]

    line_bg, = ax.plot(x_expr[master_mask][::5], y_expr[master_mask][::5], linestyle='', marker='o', markersize=1, color='lightgrey', zorder=1)

    xmin, xmax = np.percentile(x_expr[master_mask], 0.1), np.percentile(x_expr[master_mask], 99.9)
    ymin, ymax = np.percentile(y_expr[master_mask], 0.1), np.percentile(y_expr[master_mask], 99.9)

    txt_lim = ax.text(0.5, 0.9, f"xlim ({xmin:.2f}, {xmax:.2f})\n ylim ({ymin:.2f}, {ymax:.2f})", fontsize=20, transform=ax.transAxes)

    ax.set_xlim(xmin, xmax)
    ax.set_ylim(ymin, ymax)
    
    def onselect(eclick, erelease):
        x_min, x_max = min(eclick.xdata, erelease.xdata), max(eclick.xdata, erelease.xdata)
        y_min, y_max = min(eclick.ydata, erelease.ydata), max(eclick.ydata, erelease.ydata)

        txt_lim.set_text(f"xlim ({x_min:.2f}, {x_max:.2f})\n ylim ({y_min:.2f}, {y_max:.2f})")
        
        gate_masks[id] = (x_expr >= x_min) & (x_expr <= x_max) & (y_expr >= y_min) & (y_expr <= y_max)
        gate_mask = gate_masks.all(axis=0)
        ax.figure.canvas.draw_idle()
        update_vedo(gate_mask)

    selector = RectangleSelector(ax, onselect, useblit=True, button=[1], interactive=True,
                                 grab_range=20,
                                 handle_props=dict(
                                     marker='o',
                                     markersize=25,
                                     markerfacecolor='white',
                                     markeredgecolor='red',
                                     alpha=0.9),
                                 )
    selector.extents = (np.min(x_expr), np.max(x_expr), np.min(y_expr), np.max(y_expr))
    ax.set_xlabel(x_name)
    ax.set_ylabel(y_name)
    
    return ids, line_bg, txt_lim, selector


def create_vedo_plot():
    selected_ct = np.arange(len(ct_names))
    cells_ct = [0 for i in selected_ct]
    cells_ct_ug = [0 for i in selected_ct]
    pastel_colors = np.array([
        [0.850, 0.850, 0.850],  # 0  Undifferentiated      light grey
        [0.950, 0.900, 0.550],  # 1  Baso                  butter yellow
        [0.500, 0.900, 0.900],  # 2  Eos                   light cyan
        [0.600, 0.900, 0.600],  # 3  Mast                  mint green
        [1.000, 0.750, 0.500],  # 4  Neutrophil            pastel peach
        [0.950, 0.600, 0.600],  # 5  Erythroid             soft coral
        [0.800, 0.650, 0.500],  # 6  Meg                   warm beige
        [0.750, 0.600, 0.900],  # 7  Monocyte              soft lavender
        [1.000, 0.600, 0.800],  # 8  pDC                   bubblegum pink
        [0.850, 0.550, 0.850],  # 9  Ccr7_DC               muted plum
        [0.550, 0.700, 0.950]   # 10 Lymphoid              baby blue
    ])


    final_colors_rgb = pastel_colors[Ls_end]
   
    cells = vedo.Points(Ms_saves_m1k_nca, r=7)
    cells.pointdata["rgb"] = final_colors_rgb
    cells.mapper.SetScalarModeToUsePointFieldData()
    cells.mapper.SelectColorArray('rgb')
    cells.mapper.SetColorModeToDirectScalars()
    cells.mapper.SetScalarVisibility(True)

    legend_dummy_objs = []
    for i in selected_ct:
        dummy = vedo.Points([[0,0,0]], c=pastel_colors[i])
        dummy.name = ct_names[i]
        legend_dummy_objs.append(dummy)       
    legend = vedo.LegendBox(legend_dummy_objs, pos='bottom-left', width=0.15, height=0.4)
    
    return cells, legend, Ls_end, selected_ct, pastel_colors # , cells_ct_ug



